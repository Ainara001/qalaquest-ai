# Copy to .env and change values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=qalaquest
POSTGRES_USER=qalaquest
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=5173
# API base URL as seen from the browser
VITE_API_URL=http://localhost:8000
