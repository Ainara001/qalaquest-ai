# Copy to .env and change values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=qalaquest
POSTGRES_USER=qalaquest
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=5173
# API base URL as seen from the browser
VITE_API_URL=http://localhost:8000

# --- AI (stage 3) ---
# Get a key at https://aistudio.google.com/apikey. Without it, retrieval works but AI answers are unavailable.
GEMINI_API_KEY=
# Optional. Empty = the backend picks the newest available Gemini "flash" model automatically.
GEMINI_MODEL=

# --- Routing / weather (stage 5) ---
# Host port of the Valhalla pedestrian router (built locally, see routing/prepare.sh)
VALHALLA_PORT=8002
# Optional: another OSM extract for routing
# VALHALLA_PBF_URL=https://download.geofabrik.de/asia/kazakhstan-latest.osm.pbf
# Optional comfort thresholds, e.g. '{"wind_ms": 12, "cold_apparent_c": -10}'
# WEATHER_RULES=
